      ]
    },
    {
      "name": "06 Recomendaciones con ingrediente real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recommendations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recommendations"
          ]
        },
        "description": "Requiere JWT del login",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ingredientIds\": [{{ingredientId}}],\n  \"availableMinutes\": 60,\n  \"limit\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 (requiere JWT del paso 01)', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Recomendaciones JSON',()=>pm.expect(pm.response.json()).to.be.an('array'));",
              "} else { console.log('Respuesta HTTP '+pm.response.code+'. Si es 401, ejecuta 00 y 01 antes de esta petición.'); }"
            ]
          }
        }
      ]
    },
