      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 (requiere JWT del paso 01)', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Página recetas',()=>{let a=pm.response.json();pm.expect(a.content).to.be.an('array');pm.expect(a.size).to.eql(20);});",
              "  if(pm.response.code===200){const a=pm.response.json().content;if(a.length)pm.collectionVariables.set('dishId',a[0].id);}",
              "} else { console.log('Respuesta HTTP '+pm.response.code+'. Si es 401, ejecuta 00 y 01 antes de esta petición.'); }"
            ]
          }
        }
      ]
    },
    {
