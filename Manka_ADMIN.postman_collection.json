          ],
          "path": [
            "recommendations"
          ]
        },
        "description": "Requiere JWT del login",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ingredientIds\": [{{ingredientId}}],\n  \"availableMinutes\": 60,\n  \"limit\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
