    {
      "name": "09 Comprobación de administrador (solo lectura)",
      "description": "1) Define adminEmail y adminPassword en el Environment. 2) Ejecuta 09A para guardar adminToken. 3) Ejecuta 09B para comprobar ADMIN. 4) Ejecuta 09C para comprobar acceso a /admin/users. El login normal 01 y su accessToken no se modifican.",
      "item": [
        {
          "name": "09A Login como ADMIN (guarda adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Configura adminEmail y adminPassword en el Environment importado. No reutiliza el token de usuario normal; guarda el token ADMIN en adminToken. No compartas variables exportadas con contraseñas."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('adminToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login administrador: HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const token = body.token || body.accessToken || body.access_token;",
                  "  pm.test('Se recibió el JWT del administrador', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "  if (typeof token === 'string' && token.length > 0) pm.environment.set('adminToken', token);",
                  "} else {",
                  "  console.warn('No se obtuvo una sesión de administrador. Verifica adminEmail/adminPassword y el backend.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09B Verificar rol ADMIN — GET /users/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ejecuta 09A primero. Devuelve el usuario autenticado y comprueba que tenga rol ADMIN. No cambia la base de datos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('/users/me: HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const raw = Array.isArray(data.roles) ? data.roles : [];",
                  "  const roles = raw.map(r => typeof r === 'string' ? r : (r && (r.name || r.authority || r.role)) || '');",
                  "  console.log('Roles que devuelve /users/me:', roles);",
                  "  pm.test('La cuenta tiene el rol ADMIN', () => pm.expect(roles.some(r => r === 'ADMIN' || r === 'ROLE_ADMIN')).to.eql(true));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09C Listar usuarios (solo ADMIN) — GET /admin/users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ejecuta 09A primero. Espera HTTP 200 si la sesión tiene ADMIN; un usuario normal sin permiso debería recibir 403. Solo lectura, no modifica roles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('/admin/users: HTTP 200 con ADMIN', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('La respuesta tiene datos de usuarios', () => pm.expect(Array.isArray(body) || Array.isArray(body.content)).to.eql(true));",
                  "} else {",
                  "  console.warn('Respuesta de administración:', pm.response.code, 'Comprueba el JWT y el rol ADMIN');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
